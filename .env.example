# The port where the server should listen for requests
# Default: 8080
PORT=8080

# The database connection string to a running postgresql database
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Default: postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable

# A database connection string to a running postgresql database that has
# has no tables or prior migrations
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Default: postgresql://postgres:postgres@localhost:5432/dev?sslmode=disable
DEV_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?sslmode=disable