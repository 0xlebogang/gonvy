{
	"name": "@repo/vitest",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./base": "./dist/configs/base-config.js",
		"./ui": "./dist/configs/ui-config.js"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"merge-blob-reports": "node dist/scripts/merge-blob-reports.js",
		"report": "vitest --merge-reports coverage/merged-blob --passWithNoTests --coverage --coverage.provider=istanbul --coverage.reporter=html --coverage.reporter=text --coverage.reportsDirectory=coverage/report",
		"view-report": "open coverage/report/index.html"
	},
	"dependencies": {
		"vitest": "^4.1.10"
	},
	"devDependencies": {
		"@repo/biome": "workspace:*",
		"@repo/tsconfig": "workspace:*",
		"@vitest/coverage-istanbul": "^4.1.10",
		"@vitest/ui": "4.1.9",
		"jsdom": "^26.1.0",
		"typescript": "^6.0.3"
	}
}
